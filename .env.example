# --- Infrastructure ---
# Neon PostgreSQL (Production)
# Get connection string from Neon Dashboard: https://console.neon.tech
# Enable connection pooling for better performance: ?pgbouncer=true
DATABASE_URL="postgresql://username:password@ep-cool-region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Alternative: Direct connection without pooling
# DATABASE_URL="postgresql://username:password@ep-cool-region.aws.neon.tech/neondb?sslmode=require"

# Redis (Production - use Redis Cloud or Render Redis)
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret-32-chars-min"
JWT_REFRESH_SECRET="change-me-refresh-secret-32-chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
OTP_TTL_MINUTES="10"

# --- OTP delivery ---
# "true" requires email confirmation (OTP) before login/org creation; "false" signs in
# immediately after registration (OTP machinery stays dormant).
OTP_REQUIRED="false"
# Transport: "console" (log OTP to API log), "smtp" (SMTP_* creds), or "ethereal"
# (dev sandbox -> real SMTP to a free preview inbox, no credentials needed).
# Default: "smtp" when SMTP_HOST is set, else "ethereal" in dev / "console" in prod.
OTP_TRANSPORT="ethereal"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-account@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="ETHIO-BRIDGE <no-reply@ethio-bridge.local>"
# SMTP_TLS_REJECT_UNAUTHORIZED="true"

# --- Platform ---
PORT=3001
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000"
WEB_URL="http://localhost:3000"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"