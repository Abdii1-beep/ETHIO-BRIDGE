4:["$","html",null,{"lang":"zh","children":[["$","head",null,{"children":["$","link",null,{"rel":"icon","href":"/logo.png","type":"image/png"}]}],["$","body",null,{"style":{"margin":0,"padding":0},"children":["$","$L10",null,{"locale":"zh","messages":{"common":{"appName":"ETHIO-BRIDGE","tagline":"AI驱动的埃塞俄比亚-中国商业与商务平台","logout":"退出登录","loading":"加载中…","saving":"保存中…","error":"出错了。","retry":"重试","language":"语言","heroBadge":"埃塞俄比亚 ↔ 中国 ↔ 全球","heroTitle":"连接企业。","heroSubtitle":"跨越边界。全球增长。","heroDescription":"ETHIO-BRIDGE 帮助埃塞俄比亚、中国和全球企业发现值得信赖的合作伙伴，跨越语言沟通，采购产品，寻找买家并创造新的商业机会。","startBusiness":"免费开始您的业务","exploreBusinesses":"探索企业","trustDiscovery":"全球商业发现","aiPowered":"AI驱动","fourLanguages":"4种语言","businessPrivacy":"商业优先隐私","builtToScale":"可扩展构建","findRightBusiness":"找到合适的企业","discoverSuppliers":"发现供应商、买家、制造商和商业机会","searchAcross":"在埃塞俄比亚、中国和全球市场搜索。为您的业务需求找到经过验证的合作伙伴。","searchPlaceholder":"您在寻找什么？（例如，太阳能水泵、农业机械）","searchButton":"搜索","popular":"热门：","solarPumps":"太阳能水泵","agriMachinery":"农业机械","coffeeSuppliers":"咖啡供应商","electronics":"电子产品","construction":"建筑材料","searchAcrossLanguages":"使用AI跨语言搜索","searchAcrossLanguagesDesc":"用任何语言输入搜索词，发现英语、中文、阿姆哈拉语和阿法奥罗莫语的企业","everythingInOnePlace":"一切尽在一处","builtForCommerce":"为真正的跨境贸易而建","builtForCommerceDesc":"从产品发现到最终交付，每个工具都是实时功能运行的——没有演示屏幕，没有占位符。","learnMore":"了解更多 →","oneBridge":"一座桥梁。两个市场。无限可能。","connectingEthiopiaChina":"连接埃塞俄比亚和中国企业","connectingEthiopiaChinaDesc":"ETHIO-BRIDGE 消除埃塞俄比亚和中国市场之间的语言、发现和沟通障碍。","exportProducts":"出口产品","findBuyers":"寻找买家","findSuppliers":"寻找供应商","promoteBusinesses":"推广业务","createRFQs":"创建询价","connectGlobally":"全球连接","manufacturers":"制造商","suppliers":"供应商","technology":"技术","machinery":"机械","products":"产品","businessOpportunities":"商业机会","aiTranslation":"AI翻译","aiMatching":"匹配","aiCommunication":"沟通","aiDiscovery":"商业发现","aiThatUnderstands":"理解商业的AI","intelligentTools":"跨境贸易的智能工具","intelligentToolsDesc":"我们的AI不仅仅是聊天——它翻译、匹配、创建，并协助真实的业务工作流程。","aiTranslate":"翻译","aiTranslateDesc":"在谈判和文档中实时翻译英语、中文、阿姆哈拉语和阿法奥罗莫语。","aiMatch":"匹配","aiMatchDesc":"基于您的具体要求和偏好，AI驱动的供应商和买家匹配。","aiCreate":"创建","aiCreateDesc":"在AI辅助下生成专业的产品描述、业务内容和询价。","aiUnderstand":"理解","aiUnderstandDesc":"即时跨语言总结文档、报价和商业对话。","aiAssist":"协助","aiAssistDesc":"准备询价，起草专业消息，并在整个商业旅程中获得AI协助。","aiAnalyze":"分析","aiAnalyzeDesc":"市场情报和洞察，帮助您做出明智的商业决策。","howItWorks":"如何运作","fromLeadToShipment":"从线索到发货的四个步骤","fromLeadToShipmentDesc":"登录后立即开始交易——无需冗长的入门，无隐藏费用。","step1Title":"创建您的公司资料","step1Desc":"即时租户，内置角色和核心功能——无需文书工作。","step2Title":"跨境买卖","step2Desc":"发布产品，发布询价，用四种语言中的任何一种进行谈判。","step3Title":"定价您的落地成本","step3Desc":"在订购前透明计算关税、增值税、运费和费用。","step4Title":"成交、发货和增长","step4Desc":"跟踪订单和付款，ETHIO-BRIDGE保护佣金模式。","productDiscovery":"产品发现","exploreMarketplace":"探索全球市场","exploreMarketplaceDesc":"浏览来自埃塞俄比亚、中国和全球市场经过验证的供应商的产品。","solarWaterPump":"太阳能水泵","solarWaterPumpDesc":"用于农业和住宅用途的高效太阳能水泵系统。","verified":"已验证","moq":"最小起订量：100台","ethiopianCoffee":"埃塞俄比亚特色咖啡","ethiopianCoffeeDesc":"来自埃塞俄比亚高原的优质阿拉比卡咖啡豆，可供出口。","exportAvailable":"可出口","agriMachineryCard":"农业机械","agriMachineryCardDesc":"用于现代农业运营的先进农业设备和机械。","moq50":"最小起订量：50台","knowWhoYoureDoingBusinessWith":"了解您的商业伙伴","trustAndVerification":"信任和验证","trustAndVerificationDesc":"ETHIO-BRIDGE 提供工具帮助您验证和信任您的商业合作伙伴。","businessVerification":"企业验证","businessVerificationDesc":"经过验证的企业资料，包含公司信息、业务类型和验证状态。","transactionHistory":"交易历史","transactionHistoryDesc":"在适用的情况下查看交易历史，以评估企业的可靠性和绩效。","reviewsAndRatings":"评论和评级","reviewsAndRatingsDesc":"平台上其他经过验证的用户的企业评论和评级。","riskSignals":"风险信号","riskSignalsDesc":"AI驱动的风险评估，帮助您在交易前识别潜在问题。","buildYourNextConnection":"建立您的下一个商业联系。","buildYourNextConnectionDesc":"加入ETHIO-BRIDGE，连接埃塞俄比亚、中国及其他地区的企业。免费开始，仅在需要时付费。","createBusinessAccount":"创建企业账户","exploreBusinessHub":"探索商业中心","welcome":"欢迎","memberOf":"成员","signIn":"登录","publishNewProduct":"创建新产品","category":"类别","countryOfOrigin":"原产国","unitPrice":"单价","originalPriceDiscount":"原价（折扣%）","currency":"货币","currencySymbol":"货币符号","productImages":"商品图片","productVideo":"产品视频链接（可选）","addVideo":"添加演示视频以增强买家信心。","productTitleO