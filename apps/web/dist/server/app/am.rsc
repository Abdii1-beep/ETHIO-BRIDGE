4:["$","html",null,{"lang":"am","children":[["$","head",null,{"children":["$","link",null,{"rel":"icon","href":"/logo.png","type":"image/png"}]}],["$","body",null,{"style":{"margin":0,"padding":0},"children":["$","$L10",null,{"locale":"am","messages":{"common":{"appName":"ETHIO-BRIDGE","tagline":"AI-የሚመራ ኢትዮጵያ-ቻይና የንግድ እና የንግድ መድረክ","logout":"ውጣ","loading":"በመጫን ላይ…","saving":"በማስቀመጥ ላይ…","error":"ስህተት ተፈጥሯል።","retry":"እንደገና ሞክር","language":"ቋንቋ","heroBadge":"ኢትዮጵያ ↔ ቻይና ↔ አለም","heroTitle":"ድርስናዎችን ያገናኝ።","heroSubtitle":"ድንበሞችን አልፍ። አለም አቀፍ ይራቅ።","heroDescription":"ETHIO-BRIDGE የኢትዮጵያ፣ የቻይና እና የአለም ድርስናዎች ተቀባዮማ አጋሮችን ለማግኘት፣ ቋንቋዎችን ለመገናኘት፣ ምርቶችን ለማግኘት፣ ገዢዎችን ለማግኘት እና አዲስ የንግድ እድሎችን ለመፍጠር ይረዳል።","startBusiness":"ድርስናዎን በነጻ ይጀምሩ","exploreBusinesses":"ድርስናዎችን ያስሱ","trustDiscovery":"አለም አቀፍ የንግድ ፍለጋ","aiPowered":"AI-የሚመራ","fourLanguages":"4 ቋንቋዎች","businessPrivacy":"የንግድ ቅድሚያ የግል ሚስጥር","builtToScale":"ለማራት የ�ሰራ","findRightBusiness":"ትክክለኛውን ድርስና ያግኙ","discoverSuppliers":"አቅራቢዎች፣ ገዢዎች፣ አምራቾች እና የንግድ እድሎችን ያግኙ","searchAcross":"በኢትዮጵያ፣ ቻይና እና በአለም አቀፍ ገበታዎች ይፈልጉ። ለድርስናዎ ፍላጎቶች ተቀባዮማ አጋሮችን ያግኙ።","searchPlaceholder":"ምን ይፈልጋሉ? (ለምሳሌ፣ የፀሐይ ውሃ ፓምፕ፣ የእርሻ ማሽናት)","searchButton":"ፈልግ","popular":"ተወዳጅ:","solarPumps":"የፀሐይ ውሃ ፓምፕ","agriMachinery":"የእርሻ ማሽናት","coffeeSuppliers":"የቡና አቅራቢዎች","electronics":"ኤሌክትሮኒክስ","construction":"የግንባት ዕቃዎች","searchAcrossLanguages":"በAI በቋንቋዎች ይፈልጉ","searchAcrossLanguagesDesc":"በማንኛውም ቋንቋ ፍለጋ ቃል ያስገቡ እና በእንግሊኝኛ፣ በቻይንኛ፣ በአማርኛ እና በአፋን ኦሮሞ ድርስናዎችን ያግኙ","everythingInOnePlace":"ሁሉም በአንድ ቦታ","builtForCommerce":"ለእውነተኛ የድንበሞች ንግድ የ�ሰራ","builtForCommerceDesc":"ከምርት ፍለጋ እስከ የመጨረሻ አስረኻ፣ እያንዳንዱ መሳሪያ በእውነተኛ ጊዜ ይሰራል——ምንም የማሳያ ገጾች የለም፣ ምንም ቦታ ባይይዝም።","learnMore":"ተጨማሪ ይወቱ →","oneBridge":"አንድ ገመድ። ሁለት ገበታዎች። የማይገደት እድሎች።","connectingEthiopiaChina":"የኢትዮጵያ እና የቻይና ድርስናዎችን ያገናኝ","connectingEthiopiaChinaDesc":"ETHIO-BRIDGE የኢትዮጵያ እና የቻይና ገበታዎች መካከር የቋንቋ፣ የፍለጋ እና የግንኙነት ቦታዎችን ያስወግዳል።","exportProducts":"ምርቶችን ወጥተው ይላኩ","findBuyers":"ገዢዎችን ያግኙ","findSuppliers":"አቅራቢዎችን ያግኙ","promoteBusinesses":"ድርስናዎችን ያስተውሉ","createRFQs":"RFQs ይፍጠሩ","connectGlobally":"አለም አቀፍ ይገናኙ","manufacturers":"አምራቾች","suppliers":"አቅራቢዎች","technology":"ቴክኖሎጂ","machinery":"ማሽናት","products":"ምርቶች","businessOpportunities":"የንግድ እድሎች","aiTranslation":"AI ትርጉም","aiMatching":"ማመሳሰር","aiCommunication":"ግንኙነት","aiDiscovery":"የንግድ ፍለጋ","aiThatUnderstands":"ንግድን የሚረዳ AI","intelligentTools":"ለድንበሞች ንግድ የሚረዳ መሳሪያዎች","intelligentToolsDesc":"AI የእኛ የብቻ አይሰነውም——ይተርጋል፣ ይሰራል፣ ይፍጠር፣ እና በእውነተኛ የንግድ የሰራት ሂደቶች ይረዳል።","aiTranslate":"ተርጉም","aiTranslateDesc":"በውይይቶች እና በሰነዶች ውስጥ በእንግሊኝኛ፣ በቻይንኛ፣ በአማርኛ እና በአፋን ኦሮሞ በእውነተኛ ጊዜ ትርጉም።","aiMatch":"ሰርዝ","aiMatchDesc":"በእርስዎ የተወሰኑ ፍላጎቶች እና ምርጫዎች ላይ የተመሠረተ AI-የሚመራ አቅራቢ እና ገዢ ማመሳሰር።","aiCreate":"ፍጠር","aiCreateDesc":"በAI እርዳታ ሙያዊ የምርት መግለጫዎች፣ የንግድ ይዘቶች እና RFQs ይፍጠሩ።","aiUnderstand":"ርዳ","aiUnderstandDesc":"ሰነዶችን፣ ዋጋዎችን እና የንግድ ውይይቶችን በቋንቋዎች በአንድ ጊዜ ያንቀሳል።","aiAssist":"ረዳ","aiAssistDesc":"RFQs ይዘጋጁ፣ ሙያዊ መልእክቶችን ይጽፉ፣ እና በሙሉ የንግድ ጉዟዎ የAI እርዳታ ያግኙ።","aiAnalyze":"ትንታኔ","aiAnalyzeDesc":"የገበቫ የመረጃ እና ምንጭ የንግድ ውሳኔዎችን ለመውሰድ ይረዳል።","howItWorks":"እንዴት ይሰራል","fromLeadToShipment":"ከመስመር እስከ መላክ አራባት ደረጃዎች","fromLeadToShipmentDesc":"ከመግባት በኋላ በወራ ይነጋገሩ——ምንም ረዘም የመግቢያ ሂደት የለም፣ ምንም የተደበቀ ክፍ የለም።","step1Title":"የኩባንዐዎን መገለጫ ይፍጠሩ","step1Desc":"አንድ ጊዜ ተከታይ፣ የተገነቡ ሚናዎች እና ዋና ባህሪያት——ምንም ወረቀት የለም።","step2Title":"በድንበሞች ይገዙ እና ይሸጡ","step2Desc":"ምርቶችን ይስሩ፣ RFQs ይስሩ፣ በአራባት ቋንቋዎች ይወያዩ።","step3Title":"የመድረሻ ዋጋዎችዎን ይወስኑ","step3Desc":"ከመግዛትዎ በፊት ጉሙሮች፣ VAT፣ የመላክ ክፍዎች እና ክፍዎችን በግልጽ ይሰሉ።","step4Title":"ይወድቁ፣ ይላኩ እና ይራዙ","step4Desc":"ትዕዛዞችን እና ክፍዎችን ያከታቱ፣ ETHIO-BRIDGE የኮሚሽን ሞዴሉን ይጠብቃል።","productDiscovery":"የምርት ፍለጋ","exploreMarketplace":"አለም አቀፍ ገበቫን ያስሱ","exploreMarketplaceDesc":"ከኢትዮጵያ፣ ቻይና እና ከአለም አቀፍ ገበታዎች ተቀባዮማ አቅራቢዎች ምርቶችን ያስሱ።","solarWaterPump":"የፀሐይ ውሃ ፓምፕ","solarWaterPumpDesc":"ለእርሻ እና ለአካባቢ አገልግሎት ከፍተኛ ብቃል ያለ የፀሐይ ኃይል ውሃ ፓምፕ ስርዓቶች።","verified":"ተረጋግጧል","moq":"አነስተኛ ትዕዛዝ: 100 ክፍሎች","ethiopianCoffee":"የኢትዮጵያ ልዩ ቡና","ethiopianCoffeeDesc":"ከኢትዮጵያ ከፍተላዊ ክረማዎች የመጡ ከፍተኛ ጥራዝ ያለ 