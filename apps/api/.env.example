# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ETB"

# JWT
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Chapa Payment Gateway
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co
CHAPA_CALLBACK_URL=http://localhost:3002/api/payments/chapa/callback
CHAPA_RETURN_URL=http://localhost:3003/payment/success
CHAPA_CANCEL_URL=http://localhost:3003/payment/cancel

# Email (Ethereal for development)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
PORT=3002
NODE_ENV=development
